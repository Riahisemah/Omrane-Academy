# Public, non-secret values used by `npm run build` (local and on Netlify).
# Never put an API key or password in a VITE_* variable: it ends up in the public JavaScript.

# Production URL (no trailing slash): canonical URLs, Open Graph and sitemap.xml.
VITE_SITE_URL=https://omrane-academy.netlify.app

# Contact form delivery. Empty = WhatsApp (number set in src/config/site.ts).
# To receive messages with Netlify Forms instead: enable "Form detection" in the Netlify
# dashboard (Site configuration > Forms), then set the value below to: netlify
VITE_CONTACT_PROVIDER=
