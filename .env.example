# Copy to .env.local and fill in. Never commit real secrets.

# Production URL (no trailing slash). Used for canonical URLs, Open Graph and sitemap.xml.
VITE_SITE_URL=

# Endpoint that receives contact form submissions as a JSON POST.
# Leave empty to keep the form in demo mode (nothing is sent).
# Example with Formspree: https://formspree.io/f/xxxxxxx
VITE_CONTACT_ENDPOINT=
